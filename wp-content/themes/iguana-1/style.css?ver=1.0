    RESPONSIVE
\*------------------------------------*/

@media only screen and (max-width:1280px) {

}
@media only screen and (-webkit-min-device-pixel-ratio:1.5),
	   only screen and (min-resolution:144dpi) {

}

/*------------------------------------*\
    MISC
\*------------------------------------*/

::selection {
	background: #7c2695;
	color: #fff;
	text-shadow:none;
}
::-webkit-selection {
	background: #7c2695;
	color: #fff;
	text-shadow:none;
}
::-moz-selection {
	background: #7c2695;
	color: #fff;
	text-shadow:none;
}

/*------------------------------------*\
    WORDPRESS CORE
\*------------------------------------*/

.alignnone {
	margin:5px 20px 20px 0;
}
.aligncenter,
div.aligncenter {
	display:block;
	margin:5px auto 5px auto;
}
.alignright {
	float:right;
	margin:5px 0 20px 20px;
}
.alignleft {
	float:left;
	margin:5px 20px 20px 0;
}
.aligncenter {
	display:block;
	margin:5px auto 5px auto;
}
a img.alignright {
	float:right;
	margin:5px 0 20px 20px;
}
a img.alignnone {
	margin:5px 20px 20px 0;
}
a img.alignleft {
	float:left;
	margin:5px 20px 20px 0;
}
a img.aligncenter {
	display:block;
	margin-left:auto;
	margin-right:auto;
}
.wp-caption {
	background:#FFF;
	border:1px solid #F0F0F0;
	max-width:96%;
	padding:5px 3px 10px;
	text-align:center;
}
.wp-caption.alignnone {
	margin:5px 20px 20px 0;
}
.wp-caption.alignleft {
	margin:5px 20px 20px 0;
}
.wp-caption.alignright {
	margin:5px 0 20px 20px;
}
.wp-caption img {
	border:0 none;
	height:auto;
	margin:0;
	max-width:98.5%;
	padding:0;
	width:auto;
}
.wp-caption .wp-caption-text,
.gallery-caption {
	font-size:11px;
	line-height:17px;
	margin:0;
	padding:0 4px 5px;
}
.sticky {

}
.bypostauthor {

}

/*------------------------------------*\
    PRINT
\*------------------------------------*/

@media print {
	* {
		background:transparent !important;
		color:#000 !important;
		box-shadow:none !important;
		text-shadow:none !important;
	}
	a,
	a:visited {
		text-decoration:underline;
	}
	a[href]:after {
		content:" (" attr(href) ")";
	}
	abbr[title]:after {
		content:" (" attr(title) ")";
	}
	.ir a:after,
	a[href^="javascript:"]:after,
	a[href^="#"]:after {
		content:"";
	}
	pre,blockquote {
		border:1px solid #999;
		page-break-inside:avoid;
	}
	thead {
		display:table-header-group;
	}
	tr,img {
		page-break-inside:avoid;
	}
	img {
		max-width:100% !important;
	}
	@page {
		margin:0.5cm;
	}
	p,
	h2,
	h3 {
		orphans:3;
		widows:3;
	}
	h2,
	h3 {
		page-break-after:avoid;
	}
}
@media screen and (max-width: 1280px) {
  	body {
  		width: 1000px;
    }
    body .wrapper {
      	width: 1000px;
    }
    .header .nav {
      	width: 1000px;
    }
    .header .nav .menu ul li a {
      	font-size: 14px;
  		padding: 0 14px;
    }
	.header .nav .menu ul li ul {
      	display: none;
    }
    .header .nav .search {
    	display: none;
    }
    section {
      	width: 1000px;
	}
	section .slideshow_content {
      	width: 699px !important;
	}
	section article {
		width: 639px;
	}
	section article table {
		width: 100% !important;
	}
	section article .contact .input,
	section article .contact .textarea {
		width: 617px !important;
	}
}
@media screen and (max-width: 1000px) {
  	body {
  		width: 800px;
    }
    body .wrapper {
      	width: 800px;
    }
    .header .nav {
      	width: 800px;
    }
    .header .nav .menu ul li a {
      	font-size: 12px;
  		padding: 0 10px;
  		border: 0;
    }
	.header .nav .menu ul li {
  		border: 0;
    }
    .header .nav .menu ul {
  		border: 0;
    }
    .header .nav .search {
    	display: none;
    }
    section {
      	width: 800px;
	}
	section .slideshow_content {
      	width: 499px !important;
	}
	section article {
		width: 439px;
	}
	section article .contact .input,
	section article .contact .textarea {
		width: 417px !important;
	}
}
@media screen and (max-width: 800px) {
  	html.open {
    	width: 100% !important;
    	overflow: hidden !important;
  	}
  	html.open {
		height: 100% !important;
    	width: 100% !important;
    	overflow: hidden !important;
  	}
  	body {
  		width: 100%;
    }
    body .wrapper {
      	width: 100%;
    }
  	section {
  		margin: 0;
  		box-shadow: none;
  		border-radius: 0;
    	border: 0;
  	}
    .header .nav {
      	width: 100%;
  		margin: 0;
  		position: relative;
  		box-shadow: none;
  		border-radius: 0;
	}
	.header .nav .logo {
  		background: none;
        border: 0;
    }
    .header .nav .logo a {
    	background: url("data:image/png;base64,");
    }
	.header .nav .togglemenu {
     	display: block !important;
  		color: #fff;
  		font-size: 18px;
  		position: absolute;
  		top: 0;
  		right: 0;
  		line-height: 92px;
  		padding: 0 72px 0 0;
  		cursor: pointer;
  		background: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAADAAAAAOCAYAAABpcp9aAAAABmJLR0QA/wD/AP+gvaeTAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAB3RJTUUH3gkeEikwJAtNewAAAB1pVFh0Q29tbWVudAAAAAAAQ3JlYXRlZCB3aXRoIEdJTVBkLmUHAAAAK0lEQVRIx+3UgQ0AIAzDsIb/f+6emJAQ8RGmbbMIIBedSHoaLiTJhb5eaAB+yAwKfdD8tAAAAABJRU5ErkJggg==") center right no-repeat;
     }
	.header .nav .togglemenu.open {
  		background: url("data:image/png;base64,") center right no-repeat;
     }
    .header .nav .menu ul li a {
      	font-size: 16px;
  		padding: 0 20px;
  		border: 0;
  		width: auto;
  		display: block;
  		border-top: 1px solid #8629a1;
  		border-bottom: 1px solid #5a1c6c;
  		white-space: nowrap;
  		overflow: hidden;
  		text-overflow: ellipsis;
  		float: none;
    }
	.header .nav .menu ul li {
  		border: 0;
  		width: 100%;
    }
    .header .nav .menu ul {
  		border: 0;
    }
	.header .nav .menu {
      	position: absolute;
        width: 60%;
        top: 93px;
  		right: 0;
        bottom: -999px;
  		z-index: 9999;
  		background: #7c2695;
  		overflow-y: scroll;
  		display: none;
    }
	.header .nav .menu.open {
  		display: block;
    }
    .header .nav .search {
    	display: none;
    }
    section {
      	width: 100%;
	}
	section article {
		width: auto !important;
	}
	section .slideshow_content {
      	display: none !important;
	}
	section #openingstijden {
		padding: 40px 20px;
  		top: 0;
  		width: 100%;
  		background: #fff;
	}
	aside.sidebar {
  		width: 100%;
  		border: 0;
  		padding-top: 200px;
	}
	aside.sidebar ul li a {
  		width: 100% !important;
	}
	.footer {
  		background: #f5f7ef;
    	height: 24px;
    }
	.footer .menu {
  		display: none;
    }
	.footer .copyright {
    	margin: 0;
    }
	.footer .menuclose.open {
    	position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        background: rgba(0,0,0,.3);
    }
	body.page aside.navbar {
  		width: 100%;
  		position: relative !important;
  		padding: 0;
  		float: left;
  		margin: 0;
	}
	body.page aside.navbar ul {
  		padding: 0;
  		min-height: 0;
	}
	body.page aside.navbar ul li a {
  		line-height: 64px;
	}
	section .postimagenav {
  		left: 0;
  		position: relative;
	}
	section .postimagenav h1 {
  		left: 48px;
	}
	section article .artimg {
		height: 40px
	}
	section article .contact {
		width: 100% !important;
	}
	section article#post-345 {
		width: 100% !important;
	}
	section article .contact .input,
	section article .contact .textarea {
		width: 70% !important;
	}
	section .slideshow_container {
		display: none;
	}
}
/* New index 2017 */
.index_page {
	background: #f2e1ba;
	float: left;
	overflow: visible;
}
.index_page article.tickets {
	background: url("/wp-content/uploads/2017/08/tickets.jpg") center left no-repeat #fff;
	background-size: auto 100%;
	width: 100%;
	height: 320px;
	padding: 0;
}
.index_page article.tickets h2 {
	margin-top: 60px;
	margin-left: 640px;
}
.index_page article.tickets a {
	margin-top: 30px;
	margin-left: 640px;
}
.index_page article:not(.news) a {
	background: #444;
	color: #fff;
	text-decoration: none;
	padding: 0 20px;
	line-height: 64px;
	display: block;
	float: left;
	font-size: 16px;
	border-radius: 3px;
}
.index_page article:not(.news) a:hover {
	background: #555;
}
.index_page article.tickets a {
	background: #7c2695;
}
.index_page article.tickets a:hover {
	background: #8629a1;
}
.index_page article p {
	margin: 0;
	padding: 40px;
	padding-top: 0;
	float: left;
}
.index_page article.about {
	background: url("/wp-content/uploads/2017/08/about.jpg") bottom left no-repeat #b8f2cf;
	background-size: 100% auto;
	width: 66.666%;
	float: left;
	padding: 20px;
	margin: -20px;
	box-shadow: 0 3px 5px rgba(0,0,0,.1),
				0 10px 20px rgba(0,0,0,.1);
	position: relative;
	z-index: 2;
}
.index_page article.about h2,
.index_page article.news h2 {
	padding: 40px;
	padding-bottom: 0;
}
.index_page article.about a {
	margin: 0 0 40px 40px;
	background: #444;
}
.index_page article.about a:hover {
	background: #555;
}
.index_page article.news {
	width: 33.333%;
	padding: 0;
	float: left;
}
.index_page article.news ul {
	margin-top: -264px;
	position: relative;
}
.index_page article.news ul li {
	list-style: none;
	margin-right: 20px;
}
.index_page article.news ul li a {
	text-decoration: none;
	color: #444;
	float: left;
	width: 100%;
	white-space: nowrap;
	text-overflow: ellipsis;
	overflow: hidden;
	line-height: 52px;
	border-bottom: 1px solid rgba(0,0,0,.2);
}
.index_page article.news ul li:first-child a {
	padding-top: 200px;
}
.index_page article.news ul li:last-child a {
	border-bottom: 0;
}
.index_page article.news h2 {
	margin-bottom: -86px;
	margin-top: 20;
}
.index_page article.news div {
	width: 100%;
	height: 240px;
	overflow: hidden;
	padding: 0;
	position: relative;
}
.index_page article.news div:after {
	content:'';
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	height: 100px;
	background: -moz-linear-gradient(top, rgba(242,225,186,0) 0%, rgba(242,225,186,1) 100%);
	background: -webkit-linear-gradient(top, rgba(242,225,186,0) 0%,rgba(242,225,186,1) 100%);
	background: linear-gradient(to bottom, rgba(242,225,186,0) 0%,rgba(242,225,186,1) 100%);
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#00f2e1ba', endColorstr='#f2e1ba',GradientType=0 );
}
.index_page article.news div img {
	width: 100%;
	margin-top: 120px;
	transform: translateY(-50%);
	float: left;
	opacity: .3;
}
.index_page article.news ul li:last-child {
	border-bottom: 0;
}
.index_page article.animals {
	width: 100%;
	padding: 0;
	float: left;
	overflow: visible;
}
.index_page article.animals div {
	width: 33.333%;
	height: 440px;
	padding: 0;
	float: left;
}
.index_page article.animals div h2 {
	margin: 40px;
	margin-top: 60px;
}
.index_page article.animals .amphibians {
	background: url("/wp-content/uploads/2017/08/amphibians.jpg") no-repeat bottom center #f2eeba;
	background-size: 100% auto;
	position: relative;
	z-index: 1;
}
.index_page article.animals .reptils {
	background: url("/wp-content/uploads/2017/08/reptils.jpg") no-repeat bottom center #cfeab2;
	background-size: 100% auto;
}
.index_page article.animals .arthropods {
	background: url("/wp-content/uploads/2017/08/anthropods.jpg") no-repeat bottom center #f2ceb8;
	background-size: 100% auto;
}
.index_page article.social {
	width: 33.333%;
	height: 522px;
	float: left;
	padding: 0;
}
.index_page article.location {
	background: url("/wp-content/uploads/2017/08/flushing.jpg") no-repeat bottom center #b8e2f2;
	background-size: 100% auto;
	width: 66.666%;
	height: 522px;
	float: left;
	padding: 20px;
	margin: -20px;
	box-shadow: 0 3px 5px rgba(0,0,0,.1),
				0 10px 20px rgba(0,0,0,.1);
	position: relative;
	z-index: 2;
}
.index_page article.location h2 {
	margin: 40px;
}
.index_page article.location a {
	margin: 0 40px 40px 40px;
}
.pt-uea-custom-amount:focus {
	border-width: 1px;
}
.donation-form,
.donation-chooser {
	display: none;
	width: 100%;
	max-width: 600px;
	float: left !important;
}
.donation-chooser {
    width: 100%;
    line-height: 0;
    padding: 0 !important;
    position: relative;
    bottom: -1px;
    z-index: 1;
}
.pt-checkout-form {
    width: auto !important;
    padding-top: 40px;
}
.pt-uea-container {
    position: relative;
}
.pt-uea-currency-before {
    position: absolute;
    left: 5px;
}
.pt-uea-custom-amount {
    width: 100% !important;
    padding-left: 18px;
    box-sizing: border-box;
}
.donation-chooser input:checked + label {
    border-color: #eaeaea;
    background: #ffffff;
    font-weight: bold;
}
.donation-chooser label {
    line-height: 48px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid transparent;
    border-bottom: 0;
    display: block;
    float: left;
    cursor: pointer;
}
input[name=donation-chooser] {
    display: none;
}