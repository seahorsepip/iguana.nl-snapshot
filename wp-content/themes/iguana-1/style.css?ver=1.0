/*
	Theme Name: Iguana
	Theme URI: http://iguana.nl
	Description: Iguana
	Version: 1.0.0
	Author: Thomas Gladdines
	Author URI: http://seapip.com
	Tags: HTML5, CSS3
*/

/*------------------------------------*\
    MAIN
\*------------------------------------*/
html {
	font-family: 'Roboto', 'Helvetica Neue', Helvetica, Arial, sans-serif;
	color:#444;
	height: 100%;
	background: url("img/bg.png") top center repeat-x #e3f5ba;
	overflow-y: scroll;
}
body {
	width: 1200px;
	margin: 0 auto;
	height: 100%;
}
/* clear */
.clear:before,
.clear:after {
    content:' ';
    display:table;
}

.clear:after {
    clear:both;
}
.clear {
    *zoom:1;
}
img {
	max-width:100%;
	vertical-align:bottom;
}
a {
	color:#444;
	text-decoration:none;
}
a:hover {
	color:#444;
}
a:focus {
	outline:0;
}
a:hover,
a:active {
	outline:0;
}
input:focus {
	outline:0;
	border:1px solid #04A4CC;
}

/*------------------------------------*\
    STRUCTURE
\*------------------------------------*/

/* wrapper */
.wrapper {
	max-width: 1280px;
	width: 100%;
	margin: 0 auto;
}
/* header */
.header {
	background: url("img/bg.png") top center repeat-x, linear-gradient(to right, #e3f5ba 0%, #eae6b2 18%, #cff2b8 36%, #f2e1ba 54%, #b8f2cf 74%, #e3f5ba 100%);
}
/* logo */
.logo {
	float: left;
	border-right: 1px solid #5a1c6c;
	height: 100%;
	background: #fff;
	padding: 0 0 1px 0;
	width: 150px;
	position: relative;
	border-radius: 3px 0 0 3px;
}
.logo a {
	background: url("img/logo.png");
	width: 180px;
	height: 115px;
	position: absolute;
	bottom: 0;
	right: 0;
}
/* nav */
.nav {
	width: 1200px;
	background: #7c2695;
	height: 92px;
	margin: 48px auto 72px auto;
	border-bottom: 1px solid #5a1c6c;
	border-radius: 5px 3px 3px 5px;
	box-shadow: 0 1px #bfe861;
	position: relative;
	z-index: 2;
}
.nav ul {
	float: left;
	border-right: 1px solid #8629a1;
	margin: 0;
	padding: 0;
}
.nav ul li {
	float: left;
	list-style: none;
	border-right: 1px solid #5a1c6c;
	margin: 0;
	padding: 0;
	position: relative;
}
.nav ul li a {
	background: #7c2695;
	float: left;
	color: #ffffcc;
	padding: 0 20px;
	line-height: 92px;
	height: 92px;
	text-decoration: none;
	border-right: 1px solid #8629a1;
	border-left: 1px solid #8629a1;
	font-size: 16px;
	white-space: nowrap;
}
.nav ul li a:hover {
	background-color: #8629a1;
}
.nav ul li ul {
	background: #7c2695;
	position: absolute;
	top: 92px;
	left: -1px;
	z-index: 999;
	min-width: 100%;
	border: 0;
	border-bottom: 1px solid #5a1c6c;
	display: none;
}
.nav ul li:hover ul {
	display: block;
}
.nav ul li:hover ul li ul {
	display: none;
}
.nav ul li ul li {
	float: none;
	border: 0;
	display: block;
	border-top: 1px solid #5a1c6c;
}
.nav ul li ul li a {
	float: none;
	border: 0;
	border-top: 1px solid #8629a1;
	border-bottom: 1px solid #8629a1;
	display: block;
	line-height: 48px;
	height: 48px;
}
.nav ul li ul li ul {
	top: -1px;
	left: 100%;
	margin-left: -1px;
	border-left: 1px solid #5a1c6c;
	display: none;
}
.nav ul li ul li:hover ul {
	display: block;
}
.nav ul li ul .page_item_has_children > a:after {
	content:"";
	border-top: 5px solid transparent;
	border-bottom: 5px solid transparent;
	border-left: 5px solid #ffffcc;
	position: absolute;
	top: 19px;
	right: 8px;
}
.nav .search {
	position: absolute;
	padding: 28px;
	height: 36px;
	right: 0;
	top: 0;
	background: -moz-linear-gradient(left, rgba(124,38,149,0) 0%, rgba(124,38,149,1) 28px);
	background: -webkit-gradient(linear, left top, right top, color-stop(0%,rgba(124,38,149,0)), color-stop(28px,rgba(124,38,149,1)));
	background: -webkit-linear-gradient(left, rgba(124,38,149,0) 0%,rgba(124,38,149,1) 28px);
	background: -o-linear-gradient(left, rgba(124,38,149,0) 0%,rgba(124,38,149,1) 28px);
	background: -ms-linear-gradient(left, rgba(124,38,149,0) 0%,rgba(124,38,149,1) 28px);
	background: linear-gradient(to right, rgba(124,38,149,0) 0%,rgba(124,38,149,1) 28px);
	border-radius: 0 5px 5px 0;
}
.nav .search input {
	float: right;
	background: #ffffff;
	border: 0;
	height: 36px;
	padding: 0 30px 0 10px;
	width: 100px;
	outline: 0;
	border-radius: 3px;
	opacity: .8;
	font-family: 'Roboto';
	color: #7c2695;
	font-size: 16px;
	transition: width .3s;
	display: none;
}
.nav .search:hover input {
	opacity: 1;
	width: 180px;
	display: block;
}
.nav .search input::-moz-placeholder {
	color: #7c2695;
}
.nav .search input::-webkit-input-placeholder {
	color: #7c2695;
}
.nav .search button {
	position: absolute;
	top: 0;
	bottom: 0;
	right: 0;
	background: url("img/searchw.png") center left no-repeat;
	border: 0;
	width: 48px;
	outline: 0;
	font-size: 0;
}
.nav .search:hover button {
	background: url("img/search.png") center left no-repeat;
}
section {
	width: 1200px;
	background: #fff;
	overflow: hidden;
	border-radius: 3px;
	margin: 0 0 72px 0;
	position: relative;
}
section article {
	float: left;
	width: 839px;
	margin: 0;
	padding: 0 30px 20px 30px;
	display: block;
	overflow: hidden;
}
section article.single {
	width: 1139px;
}
section article div,
section article span,
section article p {
	line-height: 32px;
	padding: 0 0 10px 0;
}
section h1 {
	color: #7c2695;
	padding: 0 30px;
	line-height: 64px;
	overflow: hidden;
}
section h1 a {
	color: #7c2695;
}
section article a {
	color: #7c2695;
	text-decoration: underline;
}
section article h2 a {
	text-decoration: none;
}
section table.prijzen {
}
section table.prijzen tr td {
	line-height: 36px;
	border-top: 1px solid #eee;
	border-bottom: 1px solid #eee;
	margin-top: -1px;
}
section table.prijzen tr td:first-child {
	padding: 0 240px 0 0;
}
section table.prijzen tr th {
	color: #7c2695;
	font-weight: bold;
	text-align: left;
	line-height: 36px;
	padding-top: 20px;
}
section .contact .input,
section .contact .textarea {
	background: #fff;
	color: #777;
	border: 1px solid #ddd;
	outline: 0;
	display: block;
	line-height: 24px;
	width: 817px;
	padding: 0 10px;
	outline: 0;
	margin: 20px 0;
	border-radius: 3px;
}
section .contact .input {
	height: 48px;
}
section .contact .textarea {
	height: 248px;
	padding: 12px 10px;
	max-width: 817px;
}
section .contact .button {
	line-height: 48px;
	padding: 0 10px;
	background: #7c2695;
	border: 0;
	color: #fff;
	border-bottom: 2px solid #5a1c6c;
	border-radius: 3px;
}
section .contact .button:hover {
	background: #8f2dac;
	border-bottom: 2px solid #69217e;
}
section .post-image {
	width: 100%;
	padding: 0 30px;
	margin: 0 -30px;
	display: block;
	height: 320px;
	overflow: hidden;
	position: relative;
}
section .singlepost-image {
	margin: 0;
}
section .post-image img {
	position: absolute;
	left: 0;
	right: 0;
	min-width: 100%;
	min-height: 320px;
}
section .post-image .gradient {
	position: absolute;
	left: 0;
	right: 0;
	top:0;
	bottom: 0;
	background: url("img/gradientw.png") repeat-x;
	pointer-events: none;
}
section .post-noimage h1,
section .post-image h1 {
	position: absolute;
	left: 0;
	bottom: 0;
	z-index: 1;
	text-shadow: 0 1px rgba(255,255,255,.3);
}
section .post-noimage .date,
section .post-image .date {
	position: absolute;
	right: 30px;
	bottom: 30px;
	z-index: 1;
	pointer-events: none;
	text-shadow: 0 1px rgba(255,255,255,.3);
	font-size: 18px;
	font-style: italic;
}
section .postimagenav {
	position: absolute;
	left: 331px;
	top: 0;
}
section .postimagenav img {
	width: 899px;
}
section article .artimg {
	height: 340px;
	width: 100%;
}
/*openingstijden*/
#openingstijden {
	background: #fff;
	background: rgba(255,255,255,.7);
	position: absolute;
	top: 400px;
	left: 0;
	padding: 0 20px;
}
#openingstijden:after {
	content:"";
	position: absolute;
	top: 0;
	right: -54px;
	border-top: 54px solid transparent;
	border-bottom: 54px solid transparent;
	border-left: 54px solid #fff;
	border-left: 54px solid rgba(255,255,255,.7);
}
#openingstijden h1 {
	line-height: 32px;
	font-size: 24px;
	padding: 0;
}
#openingstijden p {
	line-height: 24px;
	color: #444;
	font-size: 18px;
	font-weight: bold;
}
/* sidebar */
.sidebar {
	background: #f5f7ef;
	padding: 30px;
	width: 300px;
	padding: 0 0 9999px 0;
	margin-bottom: -9999px;
	float: right;
	border-left: 1px solid #ecefde;
	display: block;
}
.sidebar .widget {
	border-bottom: 1px solid #ecefde;
	padding: 0 20px;
}
.sidebar .widget h2,
.sidebar .widget h2 a,
.sidebar .widget h3 {
	color: #7c2695;
	font-size: 19px;
}
.sidebar .widget_advanced-featured-page-widget .more-link {
	clear: both;
	display: block;
	line-height: 48px;
	color: #7c2695;
}
.sidebar .widget_recent_entries ul {
	list-style: none;
	padding: 0;
}
.sidebar .widget_recent_entries ul li a {
	line-height: 36px;
	white-space: nowrap;
	border-bottom: 1px solid #ecefde;
	width: 260px;
	overflow: hidden;
	text-overflow: ellipsis;
	display: block;
}
.sidebar .widget_recent_entries ul li:last-child a {
	border-bottom: 0;
}
.sidebar .widget_recent_entries ul li a:hover {
	color: #7c2695;
}
/* navbar */
.navbar {
	background: #f5f7ef;
	padding: 30px;
	width: 300px;
	padding: 0 0 9999px 0;
	margin-bottom: -9999px;
	float: left;
	border-right: 1px solid #ecefde;
}
.navbar ul {
	margin: 0;
	padding: 0;
	min-height: 500px;
}
.navbar ul.children {
	min-height: 0;
}
.navbar ul li {
	margin: 0;
	padding: 0;
	list-style: none;
	position: relative;
}
.navbar ul li a {
	border-bottom: 1px solid #ecefde;
	line-height: 48px;
	padding: 0 20px;
	display: block;
	color: #4f562c;
}
.navbar ul li a:hover {
	background: #ecefde;
}
.navbar ul li ul li a {
	padding: 0 20px 0 40px;
}
.navbar ul li.current_page_item a {
	border-left: 3px solid #7c2695;
	padding: 0 20px 0 17px;
}
.navbar ul li.current_page_item ul li a {
	border-left: 0;
	padding: 0 20px 0 40px;
}
.navbar ul li ul li.current_page_item a {
	padding: 0 20px 0 37px;
}
.navbar ul li.page_item_has_children ul li a:before {
	content:"┣";
	position: absolute;
	left: 12px;
	color: #dfe4c9;
	font-size: 20px;
}
.navbar ul li.page_item_has_children ul li:last-child a:before {
	content:"┗";
}
/* posts */
.search .page,
.post {
	border-top: 1px solid #ecefde;
	border-bottom: 1px solid #ecefde;
	margin-top: -1px;
}
.search .page,
.search .post {
	width: 100%;
}
.search img,
.post img {
	float: left;
	height: 100px;
	margin: 20px 20px 20px 0;
	width: 120px;
	height: auto;
}
.search .view-article,
.post .view-article {
	color: #7c2695;
	display: block;
	margin-top: 20px;
	text-decoration: none;
}
.search p,
.post p {
	float: left;
	display: block;
	clear: both;
}
.search .date,
.post .date {
	float: left;
	font-style: italic;
	color: #666;
}
/* pagination */
.pagination {
	display: block;
	overflow: hidden;
	width: 839px;
	height: 64px;
	margin: 20px;
}
.pagination.top {
	margin: -92px 20px 20px 20px;
}
.pagination .right {
	float: right;
	margin: 16px 0 0 0;
}
.pagination .page-numbers {
	background: #7c2695;
	color: #ffffcc;
	line-height: 36px;
	padding: 0 15px;
	margin: 0 5px 0 0;
	display: block;
	float: left;
	border-top: 1px solid #8629a1;
	border-radius: 3px;
	font-size: 14px;
}
.pagination .page-numbers:hover {
	background: #8629a1;
}
.pagination .page-numbers.current {
	background: #41144e;
	border-top: 1px solid #511861;
}
/* gallery */
.gallery {
	min-height: 0;
}
.gallery p {
	margin: -20px 0 0 0;
}
.gallery article,
.gallery article .ngg-galleryoverview {
	padding: 0;
	width: 100% !important;
	margin: 0;
	float: left;
}
.gallery article .ngg-gallery-thumbnail-box {
	height: 200px;
	width: 22%;
	float: left;
	background: #7c2695;
	padding: 0;
	margin: 20px 1.5%;
	overflow: hidden;
	position: relative;
	border-radius: 3px;
}
.gallery article .ngg-gallery-thumbnail-box .ngg-gallery-thumbnail,
.gallery article .ngg-gallery-thumbnail-box .ngg-gallery-thumbnail a {
	padding: 0;
	margin: 0;
	display: block;
	width: 100%;
	height: 100%;
}
.gallery article .ngg-gallery-thumbnail-box .ngg-gallery-thumbnail:hover {
	opacity: .7;
}
.gallery article .ngg-gallery-thumbnail-box img {
	padding: 0;
	margin: 0;
	display: block;
	width: auto;
	height: auto;
	background: none;
	border: 0;
	position: absolute;
	top: 0;
	left: 0;
}
.gallery article .ngg-gallery-thumbnail-box img.youtube {
	margin-top: 0 !important;
	width: auto !important;
	height: 100% !important;
}
.gallery article .ngg-gallery-thumbnail-box .title {
	position: absolute;
	bottom: 10px;
	left: 0;
	z-index: 1;
	background: #fff;
	background: rgba(255,255,255,.7);
	line-height: 32px;
	height: 64px;
	padding: 5px 10px;
	font-size: 18px;
	font-weight: bold;
	text-align: left;
	max-width: 200px;
	white-space: nowrap;
	color: #7c2695;
	text-overflow: ellipsis;
}
.gallery article .ngg-gallery-thumbnail-box .title:after {
	content:"";
	position: absolute;
	top: 37px;
	right: -37px;
	margin: -37px 0 0 0;
	border-top: 37px solid transparent;
	border-bottom: 37px solid transparent;
	border-left: 37px solid #fff;
	border-left: 37px solid rgba(255,255,255,.7);
}
.gallery article .ngg-gallery-thumbnail-box .title .description {
	color: #444;
	max-width: 170px;
	text-overflow: ellipsis;
	overflow: hidden;
	font-size: 13px;
}
.gallery article .ngg-gallery-thumbnail-box .video {
	position: absolute;
	top: 10px;
	left: 0;
	z-index: 1;
	background: #fff;
	background: rgba(255,255,255,.7);
	line-height: 48px;
	padding: 0 10px;
	font-size: 18px;
	font-weight: bold;
}
.gallery article .ngg-gallery-thumbnail-box .video:after {
	content:"";
	position: absolute;
	top: 24px;
	right: -24px;
	margin: -24px 0 0 0;
	border-top: 24px solid transparent;
	border-bottom: 24px solid transparent;
	border-left: 24px solid #fff;
	border-left: 24px solid rgba(255,255,255,.7);
}
.gallery .ngg-navigation {
	display: block;
	overflow: hidden;
	height: 64px;
	margin: 0;
}
.gallery .ngg-navigation .page-numbers,
.gallery .ngg-navigation .current,
.gallery .ngg-navigation .prev,
.gallery .ngg-navigation .next {
	background: #7c2695;
	color: #ffffcc;
	padding: 10px 15px;
	margin: 0 5px 0 0;
	border: 0;
	border-top: 1px solid #8629a1;
	border-radius: 3px;
	font-size: 14px;
}
.gallery .ngg-navigation .page-numbers:hover,
.gallery .ngg-navigation .prev:hover,
.gallery .ngg-navigation .next:hover {
	background: #8629a1;
}
.gallery .ngg-navigation .current {
	background: #41144e;
	border-top: 1px solid #511861;
}
.sl-wrapper,
.sl-overlay {
	display: none;
}
/* lightbox */
#lightbox {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background: #000;
	display: none;
	z-index: 999;
}
#lightbox .load {
	color: #888;
	text-align: center;
	display: block;
	position: absolute;
	top: 50%;
	left: 50%;
	margin: -100px 0 0 -100px;
	line-height: 200px;
	width: 200px;
	z-index: -1;
	font-size: 16px;
}
#lightbox .img {
	width: 100%;
	height: 100%;
}
#lightbox .img img {
	display: none;
}
#lightbox .close {
	position: absolute;
	background: #fff;
	background: rgba(255,255,255,.7);
	line-height: 48px;
	padding: 0 10px;
	right: 0;
	top: 40px;
	font-size: 18px;
	font-weight: bold;
	cursor: pointer;
	z-index: 1;
}
#lightbox .close:hover {
	color: #7c2695;
}
#lightbox .close:after {
	content:"";
	position: absolute;
	top: 0;
	left: -24px;
	border-top: 24px solid transparent;
	border-bottom: 24px solid transparent;
	border-right: 24px solid #fff;
	border-right: 24px solid rgba(255,255,255,.7);
}
#lightbox .about {
	background: #fff;
	background: rgba(255,255,255,.7);
	position: absolute;
	bottom: 40px;
	left: 0;
	padding: 0 20px;
	text-align: left;
	height: 124px;
	z-index: 1;
}
#lightbox .about:after {
	content:"";
	position: absolute;
	top: 0;
	right: -62px;
	border-top: 62px solid transparent;
	border-bottom: 62px solid transparent;
	border-left: 62px solid #fff;
	border-left: 62px solid rgba(255,255,255,.7);
}
#lightbox .about h3 {
	line-height: 32px;
	font-size: 24px;
	padding: 0;
	color: #7c2695;
}
#lightbox .about p {
	line-height: 24px;
	color: #444;
	font-size: 18px;
	font-weight: bold;
}
#lightbox .prev,
#lightbox .next {
	display: none;
	z-index: 1;
}
#lightbox .prev {
	position: absolute;
	background: #fff;
	background: rgba(255,255,255,.7);
	line-height: 48px;
	padding: 0 10px;
	left: 0;
	top: 50%;
	margin: -24px 0 0 0;
	font-size: 18px;
	font-weight: bold;
	cursor: pointer;
}
#lightbox .prev:hover {
	color: #7c2695;
}
#lightbox .prev:after {
	content:"";
	position: absolute;
	top: 50%;
	right: -24px;
	margin: -24px 0 0 0;
	border-top: 24px solid transparent;
	border-bottom: 24px solid transparent;
	border-left: 24px solid #fff;
	border-left: 24px solid rgba(255,255,255,.7);
}
#lightbox .next {
	position: absolute;
	background: #fff;
	background: rgba(255,255,255,.7);
	line-height: 48px;
	padding: 0 10px;
	right: 0;
	top: 50%;
	margin: -24px 0 0 0;
	font-size: 18px;
	font-weight: bold;
	cursor: pointer;
}
#lightbox .next:hover {
	color: #7c2695;
}
#lightbox .next:after {
	content:"";
	position: absolute;
	top: 50%;
	left: -24px;
	margin: -24px 0 0 0;
	border-top: 24px solid transparent;
	border-bottom: 24px solid transparent;
	border-right: 24px solid #fff;
	border-right: 24px solid rgba(255,255,255,.7);
}
/* Disqus */
#disqus_thread div {
	display: none !important;
}
/* footer */
.footer {
	width: 100%;
	height: 240px;
}
.footer .menu ul {
	margin: 0;
	padding: 0;
}
.footer .menu ul li {
	float: left;
	list-style: none;
	padding: 0;
}
.footer .menu ul li a {
	border-bottom: 1px solid #ecefde;
	line-height: 24px;
	padding: 0 20px 0 0;
	display: block;
	color: #4f562c;
	font-size: 14px;
	font-weight: bold;
}
.footer .menu ul li ul li {
	float: none;
	margin: 0;
}
.footer .menu ul li ul li a {
	font-weight: normal;
}
.footer .menu ul li ul li ul {
	display: none;
}
.footer .copyright {
	width: 100%;
	float: left;
	margin: 64px 0 0 0;
	color: #8b984e;
	font-size: 14px;
}
.footer .copyright a {
	color: #8b984e;
}
.footer .crocodile {
	position: absolute;
	right: 0;
}

/*------------------------------------*\
	TYPOGRAPHY
\*------------------------------------*/

@font-face {
	font-family: 'Roboto';
	src: url('fonts/Roboto-Regular-webfont.eot');
	src: url('fonts/Roboto-Regular-webfont.eot?#iefix') format('embedded-opentype'), url('fonts/Roboto-Regular-webfont.woff') format('woff'), url('fonts/Roboto-Regular-webfont.ttf') format('truetype'), url('fonts/Roboto-Regular-webfont.svg#RobotoRegular') format('svg');
	font-weight: 400;
	font-style: normal;
}
@font-face {
	font-family: 'Roboto';
	src: url('fonts/Roboto-Bold-webfont.eot');
	src: url('fonts/Roboto-Bold-webfont.eot?#iefix') format('embedded-opentype'), url('fonts/Roboto-Bold-webfont.woff') format('woff'), url('fonts/Roboto-Bold-webfont.ttf') format('truetype'), url('fonts/Roboto-Bold-webfont.svg#RobotoBold') format('svg');
	font-weight: 700;
	font-style: normal;
}

